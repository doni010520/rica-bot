{
  "name": "rica-bot",
  "version": "0.1.0",
  "description": "Rica IA — WhatsApp agent para Sucesso no Resultado (migração n8n → TypeScript)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.22",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@supabase/supabase-js": "^2.49.4",
    "ai": "^4.3.16",
    "bullmq": "^5.51.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^4.96.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.11",
    "@types/pdf-parse": "^1.1.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/coverage-v8": "^3.1.4",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
