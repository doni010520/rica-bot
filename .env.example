# ============================================================
# rica-bot — variáveis de ambiente
# Copie para .env e preencha os valores reais para dev local.
# Em produção (EasyPanel) configurar todas via UI — NÃO subir .env.
# ============================================================

# Ambiente
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.5

# ─── uazapi (WhatsApp) ─────────────────────────────────────
UAZAPI_BASE_URL=https://your-uazapi-instance.example.com
UAZAPI_TOKEN=replace-with-real-token
UAZAPI_WEBHOOK_PATH=/webhook/uazapi

# ─── Supabase / Postgres ───────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[senha]@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_VECTOR_TABLE=documents

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://default:senha@host:6379

# ─── CRM API ───────────────────────────────────────────────
CRM_API_URL=https://your-crm-host.example.com
ORG_ID=00000000-0000-0000-0000-000000000000

# ─── Follow-up (worker cron) ───────────────────────────────
FOLLOWUP_CRON=0 9-18 * * 1-5
FOLLOWUP_TIMEZONE=America/Sao_Paulo
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_CLOSE_AFTER_DAYS=7

# ─── Dedup / Buffer / Chunking ─────────────────────────────
DEDUP_TTL_SECONDS=3600
MSG_BUFFER_WAIT_MS=10000
CHUNK_DELAY_MS=2500

# ─── Contatos fixos ────────────────────────────────────────
# Gestora (Maria Helena) — recebe cópia de notificações de leads
GESTORA_PHONE=55XXXXXXXXXXX
# Vanessa (RH) — usado também por HR_NOTIFY_PHONE
VANESSA_PHONE=55XXXXXXXXXXX

# ─── Sistema Lidia ON/OFF ──────────────────────────────────
LIDIA_STATUS_TABLE=LeadsAlexy
LIDIA_STATUS_COLUMN=lidia
LIDIA_TAKEOVER_OFF_COMMAND=Roberta aqui!
LIDIA_TAKEOVER_ON_COMMAND=tá mais!

# ─── Memória de chat ───────────────────────────────────────
CHAT_MEMORY_TABLE=n8n_chat_histories
CHAT_MEMORY_WINDOW=20

# ─── Candidatos / RH ───────────────────────────────────────
HR_NOTIFY_PHONE=55XXXXXXXXXXX
HR_EMAIL=rh@your-company.example

# ─── Observabilidade ───────────────────────────────────────
ALERT_WEBHOOK_URL=

# ============================================================
# Executivos (fonte de verdade — fora do repo público)
# Telefones com DDI 55, 12-13 dígitos (ex: 5511958430345)
# Validados no boot pelo Zod (formato 55 + 10/11 dígitos)
# ============================================================
EXEC_ANDRE_PHONE=55XXXXXXXXXXX
EXEC_ANDRE_EMAIL=andre@example.com

EXEC_ALEX_PHONE=55XXXXXXXXXXX
EXEC_ALEX_EMAIL=alex@example.com

EXEC_GABRIELA_PHONE=55XXXXXXXXXXX
EXEC_GABRIELA_EMAIL=gabriela@example.com

EXEC_LUCIA_PHONE=55XXXXXXXXXXX
EXEC_LUCIA_EMAIL=lucia@example.com

EXEC_CAROLINA_PHONE=55XXXXXXXXXXX
EXEC_CAROLINA_EMAIL=carolina@example.com

EXEC_HELEN_PHONE=55XXXXXXXXXXX
EXEC_HELEN_EMAIL=helen@example.com

EXEC_MARIA_HELENA_PHONE=55XXXXXXXXXXX
EXEC_MARIA_HELENA_EMAIL=maria.helena@example.com

EXEC_IRELENE_PHONE=55XXXXXXXXXXX
EXEC_IRELENE_EMAIL=irelene@example.com

EXEC_ANA_CLARA_PHONE=55XXXXXXXXXXX
EXEC_ANA_CLARA_EMAIL=anaclara@example.com

EXEC_VANESSA_PHONE=55XXXXXXXXXXX
EXEC_VANESSA_EMAIL=rh@example.com
